{
  "expo": {
    "name": "CropGuard Market",
    "slug": "cropguard-market-app",
    "scheme": "cropguardmarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/75acb9fb-ce6b-4e81-83dc-a4c8759a4003"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cropguard.market"
    },
    "android": {
      "package": "com.cropguard.market",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CropGuard to select a photo of your produce.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "75acb9fb-ce6b-4e81-83dc-a4c8759a4003"
      }
    },
    "owner": "itsriteshxs"
  }
}
