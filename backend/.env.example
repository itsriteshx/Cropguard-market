# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cropguard-market?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=cropguard_super_secret_jwt_key_2026
JWT_EXPIRE=30d

# Client URLs (for CORS & Socket.io)
CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=*

# Cloudinary (Produce Imagery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
