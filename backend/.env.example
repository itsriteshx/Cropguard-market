# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cropguard-market?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_production_jwt_secret_min_32_characters_long
JWT_EXPIRE=30d

# Client URLs (for Express CORS & Socket.io)
# In development: point to local Vite web & Expo/Metro mobile URLs
# In production: explicit HTTPS origins are mandatory (wildcard '*' is rejected at startup)
CLIENT_URL=http://localhost:5173
MOBILE_CLIENT_URL=http://localhost:8081

# Cloudinary (Produce Imagery)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# External Live APIs (Agmarknet Mandi Rates, Open-Meteo Weather, India Post Pincode, Wikimedia Media)
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_BASE_URL=https://api.data.gov.in/resource
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
INDIA_POST_PINCODE_URL=https://api.postalpincode.in/pincode
WIKIPEDIA_SUMMARY_URL=https://en.wikipedia.org/api/rest_v1/page/summary

# OTP Verification Configuration
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
REQUIRE_VERIFICATION=true

# Email Delivery Provider (console | smtp | sendgrid | resend)
EMAIL_PROVIDER=console
EMAIL_FROM=CropGuard Market <no-reply@cropguard.agri.in>
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# SMS Delivery Provider (console | 2factor | msg91 | twilio)
SMS_PROVIDER=console
TWOFACTOR_API_KEY=your_2factor_in_api_key_here
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id_here
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
